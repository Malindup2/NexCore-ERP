# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5166

# Common JWT settings for .NET services (use a strong secret, 32+ chars)
JwtSettings__Secret=CHANGE_ME_USE_A_STRONG_SECRET_32_CHARS_MIN
JwtSettings__Issuer=NexCoreAuth
JwtSettings__Audience=NexCoreClient

# AuthService email settings (required for password reset)
EmailSettings__SmtpHost=smtp.gmail.com
EmailSettings__SmtpPort=587
EmailSettings__SmtpUsername=your-email@gmail.com
EmailSettings__SmtpPassword=YOUR_GMAIL_APP_PASSWORD
EmailSettings__FromEmail=your-email@gmail.com
EmailSettings__FromName=NexCore ERP
AppSettings__FrontendUrl=http://localhost:3000

# Connection strings (set per service when running locally)
# AuthService
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=auth_db;Username=postgres;Password=YOUR_DB_PASSWORD
# HRService
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=hr_db;Username=postgres;Password=YOUR_DB_PASSWORD
# PayrollService
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=payroll_db;Username=postgres;Password=YOUR_DB_PASSWORD
# InventoryService
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=inventory_db;Username=postgres;Password=YOUR_DB_PASSWORD
# SalesService
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=sales_db;Username=postgres;Password=YOUR_DB_PASSWORD
# ProcurementService
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=procurement_db;Username=postgres;Password=YOUR_DB_PASSWORD
# AccountingService
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=accounting_db;Username=postgres;Password=YOUR_DB_PASSWORD
