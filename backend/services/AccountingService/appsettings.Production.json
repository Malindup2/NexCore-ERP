{
    "ConnectionStrings": {
        "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=accounting_db;Username=${DB_USERNAME};Password=${DB_PASSWORD}"
    },
    "JwtSettings": {
        "Secret": "${JWT_SECRET}",
        "Issuer": "NexCoreAuth",
        "Audience": "NexCoreClient"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft": "Warning"
        }
    },
    "AllowedHosts": "*"
}